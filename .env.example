# Postgres (container-internal hostname)
DATABASE_URL=postgresql://cmis:cmis@postgres:5432/cmis
POSTGRES_USER=cmis
POSTGRES_PASSWORD=cmis
POSTGRES_DB=cmis

# Redis (container-internal hostname)
REDIS_URL=redis://redis:6379/0

# Worker heartbeat
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_STALE_AFTER_SECONDS=15

# Write Gate queue
WRITE_GATE_QUEUE_NAME=cmis:write_gate
WRITE_GATE_MAX_QUEUE_DEPTH=1000
WRITE_GATE_SYNC=false
WRITE_GATE_PROVIDER_TIMEOUT_SECONDS=30

# Optional remote judge providers (local rule judge is always the final fallback)
# NIM_API_URL=
# NIM_API_KEY=
# GEMINI_API_URL=
# GEMINI_API_KEY=
