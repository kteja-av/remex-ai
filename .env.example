# Postgres (container-internal hostname)
DATABASE_URL=postgresql://cmis:cmis@postgres:5432/cmis
POSTGRES_USER=cmis
POSTGRES_PASSWORD=cmis
POSTGRES_DB=cmis

# Redis (container-internal hostname)
REDIS_URL=redis://redis:6379/0

# Worker heartbeat
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_STALE_AFTER_SECONDS=15

# Write Gate queue
WRITE_GATE_QUEUE_NAME=cmis:write_gate
WRITE_GATE_MAX_QUEUE_DEPTH=1000
WRITE_GATE_SYNC=false
WRITE_GATE_PROVIDER_TIMEOUT_SECONDS=30

# Hybrid retrieval ranking weights (tunable without code changes)
RANKING_VECTOR_WEIGHT=0.35
RANKING_KEYWORD_WEIGHT=0.40
RANKING_GRAPH_WEIGHT=0.25
RANKING_RELEVANCE_EXPONENT=1.0
RANKING_RECENCY_EXPONENT=0.35
RANKING_IMPORTANCE_EXPONENT=0.65
RANKING_RECENCY_HALF_LIFE_DAYS=30
RANKING_RRF_K=60
RANKING_CANDIDATE_MULTIPLIER=3

# Read path DB guards (design p95 budget <150ms per signal)
READ_PATH_STATEMENT_TIMEOUT_MS=150
# Lock waits fail fast so a background job holding rows cannot stall a request
READ_PATH_LOCK_TIMEOUT_MS=50

# Decay + reflection background jobs (worker maintenance loop)
DECAY_INTERVAL_SECONDS=3600
REFLECTION_INTERVAL_SECONDS=3600
DECAY_WEIGHT_AFTER_30_DAYS=0.70
DECAY_WEIGHT_AFTER_60_DAYS=0.40
DECAY_WEIGHT_AFTER_90_DAYS=0.10
DECAY_ARCHIVE_THRESHOLD=0.15
REFLECTION_MIN_CLUSTER_SIZE=2

# Optional remote judge providers (local rule judge is always the final fallback)
# NIM_API_URL=
# NIM_API_KEY=
# GEMINI_API_URL=
# GEMINI_API_KEY=
